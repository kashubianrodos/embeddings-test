# vast.ai benchmark configuration.
#   cp vast/.env.example vast/.env      # vast/.env is git-ignored — put secrets there only
# Every value below is the built-in default; uncomment a line to change it.
# Anything you export in your shell wins over this file, e.g.  MAX_HOURS=1 ./vast/bench.sh ollama
# See DESIGN.md for why each default was chosen.

# ---------------------------------------------------------------- secrets (local)
# VAST_AI_API_KEY=              # or run `vastai set api-key <KEY>` once (VAST_API_KEY also works)
# HF_KEY=                       # optional Hugging Face token; forwarded to the instance (visible in
                                # the vast console). HF_TOKEN also works. Speeds up / unthrottles downloads.

# ---------------------------------------------------------------- repo the instance clones
# REPO_URL=https://github.com/kashubianrodos/embeddings-test.git   # must be public (or embed a token)
# REPO_BRANCH=main              # default: your current local branch

# ---------------------------------------------------------------- run control
# INTERRUPTIBLE=                # 1 = bid (≈60% cheaper, can be preempted), 0 = on-demand.
                                # Empty = per-mode default: ollama 1, vllm 0.  CLI: --interruptible / --on-demand
# BID_MULTIPLIER=1.25           # bid = min_bid × this
# OUTBID_WAIT_MIN=15            # preempted instance: wait this long for it to resume, then fetch logs + destroy
# SSH_WAIT_MIN=10               # running but no SSH this long → fetch vast logs + destroy
# LOAD_WAIT_MIN=20              # still loading (image pull) this long → fetch vast logs + destroy
# FETCH_TIMEOUT=180             # seconds; log fetching can never block destroy
# MAX_HOURS=3                   # hard stop: fetch logs + destroy after this many hours, whatever the state
# MAX_RUN_USD_OLLAMA=3          # refuse to rent if the cheapest offer's estimated run cost is higher
# MAX_RUN_USD_VLLM=6
# QUICK=0                       # 1 = smoke-size benchmark (≈2 min).  CLI: --quick
# ASSUME_YES=0                  # 1 = don't ask before renting.  CLI: --yes
# VAST_DEBUG=0                  # 1 = log every vastai call + output to vast/.debug.log (HF token redacted)

# ---------------------------------------------------------------- offer ranking (total cost per run)
# est. cost = $/h × (download_GB×8000 / (inet_down × NET_EFFICIENCY) / 3600 + SETUP_HOURS + BENCH_HOURS)
#           + download_GB × inet_down_cost
# NET_EFFICIENCY=0.5            # share of advertised inet_down you actually get from HF / Docker Hub
# SETUP_HOURS=0.1               # package install, engine start, model load (excl. download)
# BENCH_HOURS_OLLAMA=0.75
# BENCH_HOURS_VLLM=1.5
# MIN_INET_DOWN_OLLAMA=500      # Mb/s
# MIN_INET_DOWN_VLLM=1000
# MAX_INET_DOWN_COST=0.02       # $/GB — skip hosts with pricey bandwidth
# MIN_RELIABILITY=0.98
# OFFER_ID=                     # force a specific offer (must pass the filters)
# EXTRA_QUERY=                  # appended to the search query, e.g. 'geolocation in [DE,NL,PL]'

# ---------------------------------------------------------------- mode: ollama (GGUF, single-user feel + quality)
# OLLAMA_IMAGE=vastai/base-image:stock-ubuntu24.04-py312-2026-09-07   # vast SSH-mode image; Ollama installed on top
# OLLAMA_VERSION=0.34.4         # pinned Ollama release installed by setup_ollama.sh
# OLLAMA_GPU_NAMES="RTX_3090,RTX_4090"   # allowed cards; ranker picks the cheapest run
# GPU_NAME=                     # pin one card for comparable speed numbers, e.g. RTX_4090 (both modes)
# OLLAMA_CUDA_MIN=12.4
# OLLAMA_DISK_GB=40
# OLLAMA_DOWNLOAD_GB=22         # model 16.8 + mmproj 0.9 + image 1.4 + Ollama ≈2
# OLLAMA_LLM_MODEL=hf.co/huihui-ai/Huihui-Qwen3.8-27B-abliterated-GGUF:Huihui-Qwen3.8-27B-abliterated-Q4_K.gguf
                                # GGUF repo commit at time of writing: 3f101cd22b7999228bbd5d79a33975414eb9758b
                                # (Ollama cannot pin a revision; the setup log records what was pulled)
# OLLAMA_NUM_PARALLEL=4         # concurrent slots; each reserves KV cache
# OLLAMA_CONTEXT_LENGTH=8192
# OLLAMA_KV_CACHE_TYPE=f16      # q8_0 halves KV memory

# ---------------------------------------------------------------- mode: vllm (serving capacity)
# VLLM_PRESET=fp8               # fp8  = leoncca Mixed-FP8 (28 GB) on 48 GB Ada/Hopper (L40S, L40, RTX 6000 Ada, H100)
                                # bf16 = original BF16 (56 GB) on one 80 GB GPU — reference only
# VLLM_IMAGE=vastai/vllm:v0.29.0-cuda-12.9      # v0.30.0-cuda-13.0 exists but needs driver ≥580 (fewer hosts)
# VLLM_CUDA_MIN=12.9
# Preset-specific (defaults shown for fp8 / bf16):
# VLLM_LLM_MODEL=leoncca/Qwen3.8-27B-Huihui-Mixed-FP8          / huihui-ai/Huihui-Qwen3.8-27B-abliterated
# VLLM_LLM_REVISION=3ea006fab18c94e486f446a874c15e25a02a0bd1  / main
# VLLM_GPU_QUERY='gpu_ram>=45 compute_cap>=890'               / 'gpu_ram>=79 compute_cap>=800'
# VLLM_DISK_GB=90                                              / 130
# VLLM_DOWNLOAD_GB=44           # weights 28 + image ≈16       / 72
# VLLM_MAX_MODEL_LEN=16384
# VLLM_GPU_MEM_UTIL=0.92
# VLLM_TP=                      # default: number of GPUs
# VLLM_EXTRA_ARGS='--language-model-only --kv-cache-dtype fp8 --reasoning-parser qwen3'
